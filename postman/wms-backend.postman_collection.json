{
  "info": {
    "name": "WMS Backend API",
    "description": "CRUD APIs for users, roles, permission groups, and permissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "roleId",
      "value": ""
    },
    {
      "key": "permissionGroupId",
      "value": ""
    },
    {
      "key": "permissionId",
      "value": ""
    },
    {
      "key": "warehouseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\",\n  \"name\": \"John Doe\",\n  \"dateOfBirth\": \"1998-10-15\",\n  \"avatar\": \"https://example.com/avatar.jpg\",\n  \"roleIds\": []\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.updated@example.com\",\n  \"password\": \"123456\",\n  \"name\": \"John Updated\",\n  \"dateOfBirth\": \"1998-10-15\",\n  \"avatar\": \"https://example.com/avatar-new.jpg\",\n  \"roleIds\": []\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
